# ============================================================
# AI Agent Config
# Copy this file to .env and fill in actual values
# ============================================================

# ---- LLM Provider ----
LLM_PROVIDER=openai

# OpenAI-compatible API
OPENAI_API_KEY=your_api_key_here
OPENAI_BASE_URL=your_openai_base_url_here
OPENAI_MODEL=deepseek-v4-pro
OPENAI_TEMPERATURE=0.1

# ---- Agent Behavior ----
MAX_ITERATIONS=99
MAX_EXECUTION_TIME_SEC=120
MAX_SHORT_TERM_ROUNDS=6
MAX_RETRIES=1


# ---- Tool Config ----
# Sandbox root for file operations
FILE_READER_ROOT=.
# Notes persistence directory
NOTES_DIR=./agent_notes
# Workspace for code execution tool
CODE_WORKDIR=./agent_workspace

# ---- Browser ----
# false = visible window (for debugging), true = headless
BROWSER_HEADLESS=false

# ============================================================
# Embedding & Vector Store
# ============================================================

# ---- Embedding Provider ----
# Options: remote (API) | tfidf (fallback, always available)
EMBEDDING_PROVIDER=remote

# Remote embedding (OpenAI-compatible API)
# Compatible with DashScope / Azure / OneAPI / any OpenAI-compatible API
REMOTE_EMBEDDING_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
REMOTE_EMBEDDING_API_KEY=your_api_key
REMOTE_EMBEDDING_MODEL=text-embedding-v3
REMOTE_EMBEDDING_DIMENSION=1024

# ---- Vector Store ----
# Options: chroma (default) | sqlite (fallback, zero-dependency)
VECTOR_STORE=chroma
CHROMA_PERSIST_DIR=./chroma_db