# ============================================================
# AI Agent Config
# Copy this file to .env and fill in actual values
# ============================================================

# ---- LLM Provider ----
# Options: openai (remote API) | ollama (local model)
LLM_PROVIDER=openai

# OpenAI-compatible API (active when LLM_PROVIDER=openai)
OPENAI_API_KEY=your_api_key_here
OPENAI_BASE_URL=your_openai_base_url_here
OPENAI_MODEL=deepseek-v4-pro
OPENAI_TEMPERATURE=0.1

# Ollama local (active when LLM_PROVIDER=ollama)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5
OLLAMA_TEMPERATURE=0.1

# ---- Agent Behavior ----
MAX_ITERATIONS=99
MAX_EXECUTION_TIME_SEC=120
MAX_SHORT_TERM_ROUNDS=6
MAX_RETRIES=1


# ---- Tool Config ----
# Sandbox root for file operations
FILE_READER_ROOT=.
# Notes persistence directory
NOTES_DIR=./agent_notes
# Workspace for code execution tool
CODE_WORKDIR=./agent_workspace

# ---- Browser ----
# false = visible window (for debugging), true = headless
BROWSER_HEADLESS=false